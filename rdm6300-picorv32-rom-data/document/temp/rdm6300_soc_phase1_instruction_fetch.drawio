<mxfile host="Electron" modified="2026-10-02T00:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="phase1_instruction_fetch" name="Chặng 1: Nạp mã lệnh (XIP)">
    <mxGraphModel dx="1800" dy="1865" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1865" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;b style=&quot;font-size:26px;&quot;&gt;CHẶNG 1: NẠP MÃ LỆNH TỪ SPI FLASH QUA SOC_INTERCONNECT (INSTRUCTION FETCH - XIP)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;color:#444;&quot;&gt;Ví dụ: Nạp mã lệnh lw a0, 0(sp) tại PC = 0x0025_0000 — Tín hiệu trên các mũi tên: rdm6300_picorv32_soc.v#tên_biến (module nguồn, module đích)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="20" y="20" width="1760" height="80" as="geometry"/>
</mxCell><mxCell id="3" value="&lt;b style=&quot;font-size:22px;&quot;&gt;CỘT 1: PicoRV32 CPU (MASTER)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#333;&quot;&gt;File nguồn: rtl/picorv32.v&lt;br/&gt;Phát chu kỳ bus: mem_valid, mem_addr, mem_wstrb&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="20" y="115" width="560" height="115" as="geometry"/>
</mxCell><mxCell id="4" value="&lt;b style=&quot;font-size:22px;&quot;&gt;CỘT 2: soc_interconnect (TRỌNG TÀI BUS)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#333;&quot;&gt;File nguồn: rtl/soc_interconnect.v&lt;br/&gt;Giải mã địa chỉ, bật sel_spimem = 1, ghép cpu_mem_rdata&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="620" y="115" width="560" height="115" as="geometry"/>
</mxCell><mxCell id="5" value="&lt;b style=&quot;font-size:22px;&quot;&gt;CỘT 3: BỘ ĐIỀU KHIỂN SPI FLASH (SLAVE 1)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:17px;color:#333;&quot;&gt;File nguồn: rtl/spimemio.v (Chip Flash W25Q128)&lt;br/&gt;Dải địa chỉ Flash: 0x0010_0000 - 0x00FF_FFFF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="1220" y="115" width="560" height="115" as="geometry"/>
</mxCell><mxCell id="6" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=2;strokeColor=#888888;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="300" y="1845" as="sourcePoint"/>
    <mxPoint x="300" y="230" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="7" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=2;strokeColor=#888888;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="900" y="1845" as="sourcePoint"/>
    <mxPoint x="900" y="230" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="8" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=2;strokeColor=#888888;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="1500" y="1845" as="sourcePoint"/>
    <mxPoint x="1500" y="230" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="9" value="&lt;b style=&quot;font-size:19px;&quot;&gt;[GHI CHÚ] Khối 1KB SRAM nghỉ ngơi do sel_sram = 0 (Bộ nhớ SRAM không hoạt động trong chu kỳ nạp lệnh)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
  <mxGeometry x="20" y="245" width="1760" height="55" as="geometry"/>
</mxCell><mxCell id="10" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 1: CPU phát chu kỳ nạp mã lệnh&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• mem_valid = 1 & mem_instr = 1 (Nạp mã máy)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• mem_addr = 0x0025_0000 (Địa chỉ PC nạp lệnh)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• mem_wstrb = 4'b0000 (Chu kỳ đọc, không ghi)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="20" y="320" width="560" height="170" as="geometry"/>
</mxCell><mxCell id="11" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 2: Interconnect giải mã & chọn Flash&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• So khớp: 32'h0025_0000 ∈ [Flash 0x0010_0000..]&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• Bật sel_spimem = 1 (Kích hoạt bộ điều khiển Flash)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• Khóa sel_sram = 0 (Khối 1KB SRAM nghỉ ngơi)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="620" y="620" width="560" height="170" as="geometry"/>
</mxCell><mxCell id="12" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 3: spimemio phát xung SPI đọc Flash&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• FSM kéo flash_csb = 0, phát chuỗi xung flash_clk&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• Fast Read phát qua io0, nhận dữ liệu qua io1&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• CPU rơi vào Stall (cpu_state = Stall trong picorv32.v)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="1220" y="920" width="560" height="170" as="geometry"/>
</mxCell><mxCell id="13" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 4: Flash trả về từ mã máy 32-bit&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• spimem_rdata = Mã opcode 32-bit của lệnh 'lw'&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• Bật spimem_ready = 1 (Hoàn tất đọc 4 byte Flash)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="1220" y="1115" width="560" height="135" as="geometry"/>
</mxCell><mxCell id="14" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 5: Interconnect ghép mã lệnh về CPU&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• mem_rdata = spimem_rdata (Chuyển mã lệnh về CPU)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• mem_ready = spimem_ready = 1 (Báo CPU chốt lệnh)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="620" y="1380" width="560" height="135" as="geometry"/>
</mxCell><mxCell id="15" value="&lt;b style=&quot;font-size:21px;&quot;&gt;Bước 6: CPU nhận mã lệnh vào IR & Giải phóng&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:18px;&quot;&gt;• Chốt reg_op = mem_rdata (Thanh ghi lệnh IR)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• Hạ mem_valid = 0 (Kết thúc chu kỳ bus nạp lệnh)&lt;/span&gt;<br/>&lt;span style=&quot;font-size:18px;&quot;&gt;• CHẶNG 1 HOÀN TẤT (MÃ LỆNH ĐÃ VÀO CPU)!&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2.5;align=left;spacingLeft=16;spacingRight=16;" vertex="1" parent="1">
  <mxGeometry x="20" y="1645" width="560" height="170" as="geometry"/>
</mxCell><mxCell id="16" value="&lt;b style=&quot;font-size:19px;&quot;&gt;rdm6300_picorv32_soc.v#mem_valid, #mem_addr&lt;br/&gt;(từ picorv32 ➔ soc_interconnect)&lt;/b&gt;" style="endArrow=classic;html=1;strokeWidth=3.5;strokeColor=#000000;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="300" y="560" as="sourcePoint"/>
    <mxPoint x="900" y="560" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="17" value="&lt;b style=&quot;font-size:19px;&quot;&gt;rdm6300_picorv32_soc.v#sel_spimem&lt;br/&gt;(từ soc_interconnect ➔ spimemio)&lt;/b&gt;" style="endArrow=classic;html=1;strokeWidth=3.5;strokeColor=#000000;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="900" y="860" as="sourcePoint"/>
    <mxPoint x="1500" y="860" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="18" value="&lt;b style=&quot;font-size:19px;&quot;&gt;rdm6300_picorv32_soc.v#spimem_rdata, #spimem_ready&lt;br/&gt;(từ spimemio ➔ soc_interconnect)&lt;/b&gt;" style="endArrow=classic;html=1;strokeWidth=3.5;strokeColor=#000000;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="1500" y="1320" as="sourcePoint"/>
    <mxPoint x="900" y="1320" as="targetPoint"/>
  </mxGeometry>
</mxCell><mxCell id="19" value="&lt;b style=&quot;font-size:19px;&quot;&gt;rdm6300_picorv32_soc.v#mem_rdata, #mem_ready&lt;br/&gt;(từ soc_interconnect ➔ picorv32)&lt;/b&gt;" style="endArrow=classic;html=1;strokeWidth=3.5;strokeColor=#000000;labelBackgroundColor=#ffffff;align=center;" edge="1" parent="1">
  <mxGeometry width="50" height="50" relative="1" as="geometry">
    <mxPoint x="900" y="1585" as="sourcePoint"/>
    <mxPoint x="300" y="1585" as="targetPoint"/>
  </mxGeometry>
</mxCell>
      </root>
    </mxGraphModel>
  </diagram>
